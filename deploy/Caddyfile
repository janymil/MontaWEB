# MontaWeb — bloque de sitio para el Caddyfile compartido del VPS (/etc/caddy/Caddyfile).
#
# ⚠️ NO copies este archivo ENCIMA de /etc/caddy/Caddyfile: ese archivo ya contiene
#    kaptia.app, librodigital.pe, mt5connector.uk, etc. Añade SOLO los bloques
#    `www.montaweb.pe { … }` y `montaweb.pe { … }` al final del Caddyfile compartido y luego:
#        caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
#        systemctl reload caddy
#    (No incluye bloque global `{ email … }`: solo puede haber uno por Caddyfile.)
#
# ⚠️ El document root REAL del servidor es /var/www/montaweb (no …/public_html).
# ⚠️ Caddy NO lee .htaccess: los bloqueos, las URLs limpias y los headers están aquí.
#
# Estado actual del VPS (2026-11-07): php8.3-fpm INSTALADO y enganchado abajo con
# `php_fastcgi /api/*.php`. Hardening en /etc/php/8.3/fpm/conf.d/99-montaweb.ini.
# Pendiente para que el correo salga de verdad: crear api/config.php (desde
# config.example.php) con la contraseña de aplicación de Zoho y garantizar que el
# buzón destinatario exista (mx.zoho.com responde 550 5.1.1 si no existe).

# www es solo un alias: redirige a la versión canónica sin www (evita contenido duplicado).
www.montaweb.pe {
	redir https://montaweb.pe{uri} 301
}

montaweb.pe {
	root * /var/www/montaweb

	# /index y /index.html sirven una copia de la portada: unificar en "/".
	redir /index / 301
	redir /index.html / 301

	# /comparar pages dropped on 2026-11-26 (decision 2026-11-26-comparar-competitor-selection.md).
	# Their sealed evidence stays in docs/evidence/comparar/2026-11-25*/ for 5 years.
	@comparar_dropped path /comparar/nubix /comparar/kozma-360 /comparar/talentuperu /comparar/nubix/ /comparar/kozma-360/ /comparar/talentuperu/
	redir @comparar_dropped /comparar 301

	encode gzip zstd

	# ---------- Maps diagnostico reports: /d/<token>/ ----------
	# Private per-business reports, kept OUTSIDE the checkout and uploaded by
	# scripts/maps-diagnostico/publish.mjs. Only the page, report.png and report.pdf are reachable:
	# no listing, no markers, unknown token = 404. Not in sitemap; robots.txt must NOT block /d/
	# (crawlers have to be able to read the noindex).
	@reports path /d /d/*
	handle @reports {
		header {
			X-Robots-Tag "noindex, nofollow"
			Cache-Control "private, no-store"
		}
		@noSlash path_regexp noSlash ^/d/([A-Za-z0-9_-]{12})$
		redir @noSlash /d/{re.noSlash.1}/ 308

		@reportFile path_regexp ^/d/[A-Za-z0-9_-]{12}/(report\.png|report\.pdf)?$
		handle @reportFile {
			uri strip_prefix /d
			# `root` as a subdirective: the site root stays in force for the 404 page.
			file_server {
				root /var/www/montaweb-reports
			}
		}
		handle {
			error 404
		}
	}

	# ---------- 1. Nunca servir secretos, logs ni documentación ----------
	@private path /api/config.php /api/config.example.php /api/leads /api/leads/* /api/*.log /montaweb-mail-config.php
	respond @private 404

	@docs path *.md
	respond @docs 404

	@dotfiles path /.git /.git/* /.gitignore /.env /.env.* /.htaccess /.user.ini /.replit /serve.py /package.json /package-lock.json /api/.htaccess
	respond @dotfiles 404

	# Repo internals (tooling, tests, deploy config) are not part of the site (2026-11-25 incident review)
	@internal path /.claude /.claude/* /.devkit /.devkit/* /deploy /deploy/* /test /test/* /graft /graft/* /.mcp.json /.clinerules /.ignore /verify.sh /test.php
	respond @internal 404

	# Un .php fuera de /api/ lo entregaría file_server como texto plano (php_fastcgi
	# solo cubre /api/*.php), filtrando el archivo entero. Ej.: un secrets file
	# dejado en la raíz del webroot.
	@phpOutside {
		path *.php
		not path /api/*.php
	}
	respond @phpOutside 404

	# ---------- 2. PHP-FPM (solo /api/*.php) ----------
	# Socket real: `ls /run/php/`. El usuario caddy pertenece al grupo www-data,
	# que es dueño del socket. Los `respond` de arriba se evalúan antes, así que
	# /api/config.php y /api/leads/ nunca llegan a PHP.
	php_fastcgi /api/*.php unix//run/php/php8.3-fpm.sock {
		read_timeout 60s
		write_timeout 60s
	}

	# ---------- 4. /pagina.html → /pagina (igual que el .htaccess antiguo) ----------
	# El placeholder es {re.<nombre_regexp>.<grupo>}: si se usa `{re.clean}` a secas
	# resuelve a "" y el redir acaba mandando todo a "/".
	@htmlFile path_regexp html ^/(?P<clean>.+)\.html$
	redir @htmlFile /{re.html.clean} 301

	# ---------- 5. URLs limpias: /brief → /brief.html ----------
	@cleanUrl {
		not path /api/*
		not file {path}
		file {path}.html
	}
	rewrite @cleanUrl {path}.html

	# ---------- 6. Archivos estáticos ----------
	file_server

	# ---------- 7. Headers de seguridad + política de caché ----------
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# HTML siempre revalida; los assets llevan TTL. Va dentro de `route` para
	# conservar el orden: Caddy reordena las rutas `header` por especificidad.
	route {
		header Cache-Control "no-cache"
		header /css/* Cache-Control "public, max-age=86400"
		header /js/* Cache-Control "public, max-age=86400"
		header /images/* Cache-Control "public, max-age=604800"
		header /attached_assets/* Cache-Control "public, max-age=604800"
	}

	# ---------- 8. Página 404 propia ----------
	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	import visitlog
}

